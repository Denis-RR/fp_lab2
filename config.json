          "enabled": true,
          "minimumCount": 2
        },
        "uppercase": {
          "enabled": true,
          "minimumCount": 2
        },
        "digits": {
          "enabled": true,
          "minimumCount": 2
        },
        "special": {
          "enabled": true,
          "minimumCount": 1,
          "characters": "!@#$%^&*"
        }
      },
      "forbiddenCharacters": "Kk",
      "allowRepeatedCharacters": false,
